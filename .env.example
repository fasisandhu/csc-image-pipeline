# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# CSC Studio brain, per user (owner shown; other users use STUDIO_<USER>_...). Never commit values.
# STUDIO_OWNER_CLAUDE: subscription | api_key | none (unset = none, Gemini only)
STUDIO_OWNER_CLAUDE=
# Subscription token (claude setup-token). Blank = the logged-in Claude Code session (owner only)
STUDIO_OWNER_CLAUDE_OAUTH_TOKEN=
STUDIO_OWNER_ANTHROPIC_API_KEY=
# Monthly cap for API-key spend in USD (default 5)
STUDIO_OWNER_CLAUDE_CAP_USD=
# Quick tasks go to: claude | gemini (default claude)
STUDIO_FAST_TASKS=
